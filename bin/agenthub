#!/usr/bin/env bash
set -e

# Resolve symlink to get root directory
SCRIPT_SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SCRIPT_SOURCE" ]; do
  SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_SOURCE")" >/dev/null 2>&1 && pwd)"
  SCRIPT_SOURCE="$(readlink "$SCRIPT_SOURCE")"
  [[ $SCRIPT_SOURCE != /* ]] && SCRIPT_SOURCE="$SCRIPT_DIR/$SCRIPT_SOURCE"
done
ROOT_DIR="$(cd -P "$(dirname "$SCRIPT_SOURCE")/.." >/dev/null 2>&1 && pwd)"
CLI_PATH="$ROOT_DIR/dist/cli.js"

if [ ! -f "$CLI_PATH" ]; then
  echo "Error: $CLI_PATH not found. Run 'npm run build' first in $ROOT_DIR." >&2
  exit 1
fi

# Release installs pin the Node their native modules were built for (written by install.sh).
NODE_BIN=""
if [ -f "$ROOT_DIR/.node-bin" ]; then
  NODE_BIN="$(head -n 1 "$ROOT_DIR/.node-bin")"
  [ -x "$NODE_BIN" ] || NODE_BIN=""
fi
if [ -z "$NODE_BIN" ]; then
  # Source checkouts: prefer Node 22 through nvm when available.
  if [ -s "$HOME/.nvm/nvm.sh" ]; then
    export NVM_DIR="$HOME/.nvm"
    # shellcheck source=/dev/null
    . "$NVM_DIR/nvm.sh"
    nvm use 22 >/dev/null 2>&1 || true
  fi
  NODE_BIN="node"
fi

exec "$NODE_BIN" "$CLI_PATH" "$@"
